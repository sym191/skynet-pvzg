file(READ "${CONFIG}" content)
set(log "${CONFIG}.custom.log")
file(WRITE "${log}" "")
file(WRITE "${CONFIG}.custom.lua" "${content}\nlogservice = 'nativelogger'\nlogger = '${log}'\nstage3_custom_logger = true\n")
if(VARIANT STREQUAL "refactor")
    file(APPEND "${CONFIG}.custom.lua" "stage3_log_drain = true\n")
endif()
execute_process(COMMAND "${SKYNET}" "${CONFIG}.custom.lua"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
if(NOT result EQUAL 0 OR NOT output MATCHES "STAGE3_OK" OR output MATCHES "STAGE3_FAILED")
    message(FATAL_ERROR "custom logger bootstrap failed (${result})\n${output}\n${error}")
endif()
file(READ "${log}" messages)
if(NOT messages MATCHES "STAGE3_LOG_MARKER")
    message(FATAL_ERROR "custom C logger did not receive the final Lua log message")
endif()
